# Supabase (live mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server only — never commit or expose to the browser
SUPABASE_SECRET_KEY=your_secret_key

# Connector marketing: private_build (default) hides unfinished providers; launch shows operational + optional teasers
# NEXT_PUBLIC_CONNECTOR_PUBLIC_PHASE=private_build

# Optional: override discovery call scheduling
# NEXT_PUBLIC_DISCOVERY_SCHEDULING_URL=https://calendly.com/scheduleravenview
# NEXT_PUBLIC_GUIDED_SETUP_SCHEDULING_URL=https://calendly.com/scheduleravenview

# After seed: passwords live in .dev-seed-credentials.json (gitignored)

# Google Calendar (Milestone 4A — server only except redirect URI origin)
# GOOGLE_CALENDAR_INTEGRATION_ENABLED=true
# Internal QA only while catalog status is in_development (not for production customers):
# GOOGLE_CALENDAR_INTERNAL_CONNECT_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=use_a_random_string_at_least_32_chars
# GOOGLE_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/integrations/google-calendar/callback
# GOOGLE_OAUTH_STATE_SECRET=optional separate HMAC secret; defaults to GOOGLE_TOKEN_ENCRYPTION_KEY

# Vercel Cron — authorize /api/cron/google-calendar-sync (recommended every 15 minutes)
# CRON_SECRET=

# QuickBooks Online — sandbox and production credentials are separate.
# Set QUICKBOOKS_ENVIRONMENT to exactly one of: sandbox | production
# This process reads only that environment's client id, secret, and encryption key.
# Leave QUICKBOOKS_CONNECTOR_VERIFIED unset until the checklist in docs/launch-checklist.md is done.
# Sandbox QA does not use that flag. It is ignored unless QUICKBOOKS_ENVIRONMENT=sandbox,
# and it does not add QuickBooks to the public connector catalog.
# QUICKBOOKS_ENVIRONMENT=sandbox
# QUICKBOOKS_SANDBOX_QA=true
# QUICKBOOKS_INTEGRATION_ENABLED=true
# QUICKBOOKS_CONNECTOR_VERIFIED=true
# QUICKBOOKS_SANDBOX_CLIENT_ID=
# QUICKBOOKS_SANDBOX_CLIENT_SECRET=
# QUICKBOOKS_SANDBOX_TOKEN_ENCRYPTION_KEY=use_a_random_string_at_least_32_chars
# QUICKBOOKS_PRODUCTION_CLIENT_ID=
# QUICKBOOKS_PRODUCTION_CLIENT_SECRET=
# QUICKBOOKS_PRODUCTION_TOKEN_ENCRYPTION_KEY=use_a_different_random_string_at_least_32_chars
# Local sandbox redirect, registered on the Intuit app's development keys:
# http://localhost:3000/api/integrations/quickbooks/callback
# QUICKBOOKS_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
# QUICKBOOKS_OAUTH_STATE_SECRET=optional separate HMAC secret; defaults to this environment's encryption key
# Optional override. Companies default to Eastern (America/New_York).
# QUICKBOOKS_REPORTING_TIMEZONE=America/New_York

# Square — sandbox and production credentials are separate.
# Set SQUARE_ENVIRONMENT to exactly one of: sandbox | production
# This process reads only that environment's application id, secret, and encryption key.
# Leave SQUARE_CONNECTOR_VERIFIED unset until the checklist in docs/launch-checklist.md is done.
# Sandbox QA does not use that flag. It is ignored unless SQUARE_ENVIRONMENT=sandbox,
# and it does not add Square to the public connector catalog.
# Permissions requested: MERCHANT_PROFILE_READ and PAYMENTS_READ.
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_SANDBOX_QA=true
# SQUARE_INTEGRATION_ENABLED=true
# SQUARE_CONNECTOR_VERIFIED=true
# SQUARE_SANDBOX_CLIENT_ID=
# SQUARE_SANDBOX_CLIENT_SECRET=
# SQUARE_SANDBOX_TOKEN_ENCRYPTION_KEY=use_a_random_string_at_least_32_chars
# SQUARE_PRODUCTION_CLIENT_ID=
# SQUARE_PRODUCTION_CLIENT_SECRET=
# SQUARE_PRODUCTION_TOKEN_ENCRYPTION_KEY=use_a_different_random_string_at_least_32_chars
# Register this redirect on the Square application's sandbox keys:
# http://localhost:3000/api/integrations/square/callback
# SQUARE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/square/callback
# SQUARE_OAUTH_STATE_SECRET=optional separate HMAC secret; defaults to this environment's encryption key
