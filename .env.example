# Supabase (live mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server only — never commit or expose to the browser
SUPABASE_SECRET_KEY=your_secret_key

# Connector marketing: private_build (default) hides unfinished providers; launch shows operational + optional teasers
# NEXT_PUBLIC_CONNECTOR_PUBLIC_PHASE=private_build

# Optional: override discovery call scheduling
# NEXT_PUBLIC_DISCOVERY_SCHEDULING_URL=https://calendly.com/scheduleravenview
# NEXT_PUBLIC_GUIDED_SETUP_SCHEDULING_URL=https://calendly.com/scheduleravenview

# After seed: passwords live in .dev-seed-credentials.json (gitignored)
