{
  "name": "client-operations-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:isolation": "RUN_SUPABASE_ISOLATION_TESTS=1 vitest run src/lib/supabase/tenant-isolation.test.ts",
    "test:milestone2": "RUN_SUPABASE_MILESTONE2_TESTS=1 vitest run --maxWorkers=1 --fileParallelism=false src/lib/supabase/milestone2-live-writes.test.ts src/lib/supabase/milestone2-scope-repair.test.ts src/lib/supabase/milestone2-scope-review-resolution.test.ts",
    "test:milestone3a": "RUN_SUPABASE_MILESTONE3A_TESTS=1 vitest run --maxWorkers=1 --fileParallelism=false src/lib/supabase/milestone3a-build-preview.test.ts",
    "test:milestone3b": "RUN_SUPABASE_MILESTONE3B_TESTS=1 vitest run --maxWorkers=1 --fileParallelism=false src/lib/supabase/milestone3b-build-activation.test.ts src/lib/supabase/milestone3b-online-provider-upsert.test.ts",
    "test:milestone4a": "RUN_SUPABASE_MILESTONE4A_TESTS=1 vitest run --maxWorkers=1 --fileParallelism=false src/lib/supabase/milestone4a-google-calendar.test.ts src/lib/google-calendar/*.test.ts src/lib/google-calendar/sync-one-calendar.resume.test.ts",
    "seed:dev": "node scripts/seed-dev-users.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
